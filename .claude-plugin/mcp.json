{
  "mcpServers": {
    "processrecall": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "--no-dev",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "processrecall-mcp"
      ],
      "env": {
        "UV_PROJECT_ENVIRONMENT": "${CLAUDE_PLUGIN_DATA}/venv"
      }
    }
  }
}
