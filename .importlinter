[importlinter]
root_package = processrecall
unmatched_ignore_imports_alerting = none

# R17: this file is the finished layering. `processrecall.cli` and
# `processrecall.config` are declared as R17 specifies, but neither module
# exists yet (T002 deleted cli/*; config.py lands in T010) — `lint-imports`
# stays red until those tasks land, by design rather than by omission.

[importlinter:contract:layers]
name = Declared architecture layers
type = layers
layers =
    processrecall.cli | processrecall.server | processrecall.integrations
    processrecall.guidance
    processrecall.graph
    processrecall.artifacts | processrecall.symbolic
    processrecall.procedures
    processrecall.trajectory
    processrecall.config
    processrecall.exceptions

[importlinter:contract:guidance-is-rules-only]
name = Guidance is rules only — never the classifiers, never code structure
type = forbidden
source_modules =
    processrecall.guidance
forbidden_modules =
    processrecall.symbolic
    processrecall.artifacts

[importlinter:contract:hot-path-stdlib-only]
name = The hot path imports no third-party module
type = forbidden
include_external_packages = True
source_modules =
    processrecall.integrations.claude_code
    processrecall.trajectory
    processrecall.procedures
    processrecall.graph
    processrecall.guidance
    processrecall.config
forbidden_modules =
    pydantic
    pydantic_settings
    mcp
    tree_sitter
    tree_sitter_language_pack
    gliner2
    torch
    transformers

[importlinter:contract:artifacts-off-the-hot-path]
name = Code structure stays off the hot path
type = forbidden
source_modules =
    processrecall.graph
    processrecall.trajectory
forbidden_modules =
    processrecall.artifacts
