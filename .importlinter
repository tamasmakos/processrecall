[importlinter]
root_package = processrecall
unmatched_ignore_imports_alerting = none

[importlinter:contract:layers]
name = Declared architecture layers
type = layers
layers =
    processrecall.cli | processrecall.server | processrecall.integrations
    processrecall.memory
    processrecall.packs
    processrecall.ingestion | processrecall.retrieval
    processrecall.channels
    processrecall.symbolic
    processrecall.ranking
    processrecall.storage
    processrecall.models | processrecall.settings | processrecall.llm | processrecall.temporal
    processrecall.exceptions

[importlinter:contract:pipelines-independent]
name = Ingestion and retrieval must not import each other
type = independence
modules =
    processrecall.ingestion
    processrecall.retrieval

[importlinter:contract:extraction-below-stm]
name = Extraction must not import STM
type = forbidden
source_modules =
    processrecall.ingestion.extraction
forbidden_modules =
    processrecall.ingestion.stm

[importlinter:contract:core-knows-no-domain]
name = The core must not import any domain pack
type = forbidden
source_modules =
    processrecall.ingestion
    processrecall.retrieval
    processrecall.channels
    processrecall.symbolic
    processrecall.storage
forbidden_modules =
    processrecall.packs

[importlinter:contract:client-stdlib-only]
name = The out-of-process client SDK stays stdlib-only
type = forbidden
source_modules =
    processrecall.integrations.client
    processrecall.integrations.claude_code
forbidden_modules =
    processrecall.ingestion
    processrecall.retrieval
    processrecall.storage
    processrecall.channels
    processrecall.memory
