[importlinter]
root_package = graphknows
unmatched_ignore_imports_alerting = none

[importlinter:contract:layers]
name = Declared architecture layers
type = layers
layers =
    graphknows.cli | graphknows.server | graphknows.integrations
    graphknows.memory
    graphknows.packs
    graphknows.ingestion | graphknows.retrieval
    graphknows.channels
    graphknows.symbolic
    graphknows.ranking
    graphknows.storage
    graphknows.models | graphknows.settings | graphknows.llm | graphknows.temporal
    graphknows.exceptions

[importlinter:contract:pipelines-independent]
name = Ingestion and retrieval must not import each other
type = independence
modules =
    graphknows.ingestion
    graphknows.retrieval

[importlinter:contract:extraction-below-stm]
name = Extraction must not import STM
type = forbidden
source_modules =
    graphknows.ingestion.extraction
forbidden_modules =
    graphknows.ingestion.stm

[importlinter:contract:core-knows-no-domain]
name = The core must not import any domain pack
type = forbidden
source_modules =
    graphknows.ingestion
    graphknows.retrieval
    graphknows.channels
    graphknows.symbolic
    graphknows.storage
forbidden_modules =
    graphknows.packs

[importlinter:contract:client-stdlib-only]
name = The out-of-process client SDK stays stdlib-only
type = forbidden
source_modules =
    graphknows.integrations.client
    graphknows.integrations.claude_code
forbidden_modules =
    graphknows.ingestion
    graphknows.retrieval
    graphknows.storage
    graphknows.channels
    graphknows.memory
