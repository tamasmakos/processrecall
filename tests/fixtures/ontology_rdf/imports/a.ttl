# alpha -> beta -> gamma -> alpha: an owl:imports CYCLE, which is legal and
# common. The file names deliberately do not match the ontology IRIs: a catalog
# is built by parsing, never by guessing from a filename.
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex:   <https://processrecall.io/fixtures/alpha#> .

<https://processrecall.io/fixtures/alpha>
    a owl:Ontology ;
    owl:versionIRI <https://processrecall.io/fixtures/alpha/1.0.0> ;
    owl:imports <https://processrecall.io/fixtures/beta> .

ex:AlphaThing a owl:Class ; rdfs:label "Alpha Thing" .
