@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex:   <https://graphknows.io/fixtures/beta#> .

<https://graphknows.io/fixtures/beta>
    a owl:Ontology ;
    owl:versionIRI <https://graphknows.io/fixtures/beta/2.0.0> ;
    # by its VERSION IRI, which a local catalog must also answer to:
