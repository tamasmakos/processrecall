# syntax=docker/dockerfile:1
# ─── Version control ──────────────────────────────────────────────────────────
.git
.gitignore
.gitattributes

# ─── Python artifacts ─────────────────────────────────────────────────────────
.venv
__pycache__
*.py[cod]
*.pyo
*.pyd
*.egg-info
dist/
build/
*.dist-info

# ─── Testing / tooling ────────────────────────────────────────────────────────
.pytest_cache
.ruff_cache
.mypy_cache
coverage/
htmlcov/

# ─── Secrets / local config ───────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Dev tooling ──────────────────────────────────────────────────────────────
.vscode
docs

# ─── Data / output ────────────────────────────────────────────────────────────
output/
input/

# ─── Misc ─────────────────────────────────────────────────────────────────────
*.md
LICENSE
README*
docker-compose*.yaml
Makefile
# ...but README.md must stay in context: pyproject declares it as the package
# readme, so the hatchling build backend needs it to build the wheel.
!README.md
