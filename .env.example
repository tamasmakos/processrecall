# GraphKnows configuration. Copy to .env and adjust.
# Every setting is optional; the defaults run llm_free against a local ArcadeDB
# with no API keys. All variables are prefixed GRAPHKNOWS_.

# ── Mode ──────────────────────────────────────────────────────────────────────
# A preset over the capability knobs below, not a switch. Each knob can be
# overridden independently; see docs/modes.md.
GRAPHKNOWS_MODE=llm_free          # llm_free | llm_assisted
# GRAPHKNOWS_TOPICS=none          # none | extractive | llm  (extractive needs no LLM)
# GRAPHKNOWS_DSPY_RELATIONS=false # LLM relations on top of the deterministic pass

# ── ArcadeDB ──────────────────────────────────────────────────────────────────
GRAPHKNOWS_ARCADEDB_URL=http://localhost:2480
GRAPHKNOWS_ARCADEDB_USER=root
GRAPHKNOWS_ARCADEDB_PASSWORD=changeme   # set a real password outside development

# ── Embeddings ────────────────────────────────────────────────────────────────
# Local sentence-transformers model by default (no API key needed).
GRAPHKNOWS_EMBED_MODEL=BAAI/bge-small-en-v1.5
# To use a remote OpenAI-compatible endpoint instead, set these:
# GRAPHKNOWS_EMBED_API_BASE=https://api.openai.com/v1
# GRAPHKNOWS_EMBED_API_KEY=

# ── Ontology (both modes) ─────────────────────────────────────────────────────
# An RDF/OWL file OR a folder of them. Steers entity/relation extraction toward
# your vocabulary and links the graph to it. See docs/ontology.md.
# GRAPHKNOWS_ONTOLOGY=graphknows/ontology/assets/personal/personal.ttl

# ── LLM (read only by the LLM-backed capabilities) ────────────────────────────
# litellm model string; provider is inferred from the prefix.
GRAPHKNOWS_LLM_MODEL=openrouter/deepseek/deepseek-v4-flash
GRAPHKNOWS_LLM_API_KEY=
# GRAPHKNOWS_LLM_API_BASE=          # override only for self-hosted/custom endpoints
# GRAPHKNOWS_EXTRACTION_MODEL=      # optional; defaults to GRAPHKNOWS_LLM_MODEL

# GRAPHKNOWS_SUMMARIZATION_MODEL=   # optional; used by GRAPHKNOWS_TOPICS=llm

# ── Langfuse tracing (optional) ──────────────────────────────────────────────
# Its own stack, brought up separately from graphknows:
#   docker compose -f docker-compose.langfuse.yaml up -d
#   pip install 'graphknows[observability]'
#
# These two keys are what the SDK authenticates with. They are also what the
# stack PROVISIONS on first boot (LANGFUSE_INIT_PROJECT_*), so setting them
# here is enough — there is no step where you create a project in the UI and
# copy keys back out. Both must be set or the example runs untraced; it checks
# for them rather than taking a --trace flag.
LANGFUSE_PUBLIC_KEY=pk-lf-graphknows-demo
LANGFUSE_SECRET_KEY=sk-lf-graphknows-demo
# From the HOST: http://localhost:3000
# From inside graphknows-workspace: http://host.docker.internal:3000 — the two
# stacks are separate compose projects, so they share no docker network.
# Langfuse Cloud instead: https://cloud.langfuse.com, and skip the stack.
LANGFUSE_HOST=http://localhost:3000
# UI login, created on first boot only.
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_PASSWORD=changemeplease
# Change BEFORE first boot or never: rotating it makes stored secrets
# undecryptable. 64 hex chars.  openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=change-me-in-production
LANGFUSE_SALT=change-me-in-production
