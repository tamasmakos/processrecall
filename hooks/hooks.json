{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PLUGIN_ROOT/bin/bootstrap.sh\"",
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '\"$CLAUDE_PLUGIN_DATA/venv/bin/python\" -m processrecall.integrations.claude_code prompt'",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '\"$CLAUDE_PLUGIN_DATA/venv/bin/python\" -m processrecall.integrations.claude_code enforce'",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '\"$CLAUDE_PLUGIN_DATA/venv/bin/python\" -m processrecall.integrations.claude_code record'",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '\"$CLAUDE_PLUGIN_DATA/venv/bin/python\" -m processrecall.integrations.claude_code close'",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '\"$CLAUDE_PLUGIN_DATA/venv/bin/python\" -m processrecall.integrations.claude_code close'",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '\"$CLAUDE_PLUGIN_DATA/venv/bin/python\" -m processrecall.integrations.claude_code end'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
