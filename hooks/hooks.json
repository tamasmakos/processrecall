{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PLUGIN_ROOT/bin/bootstrap.sh\"",
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'if [ -e \"$CLAUDE_PLUGIN_DATA/venv/.ready\" ]; then \"$CLAUDE_PLUGIN_DATA/venv/bin/python\" -m processrecall.integrations.claude_code prompt; fi'",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'if [ -e \"$CLAUDE_PLUGIN_DATA/venv/.ready\" ]; then \"$CLAUDE_PLUGIN_DATA/venv/bin/python\" -m processrecall.integrations.claude_code enforce; fi'",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'if [ -e \"$CLAUDE_PLUGIN_DATA/venv/.ready\" ]; then \"$CLAUDE_PLUGIN_DATA/venv/bin/python\" -m processrecall.integrations.claude_code record; fi'",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'if [ -e \"$CLAUDE_PLUGIN_DATA/venv/.ready\" ]; then \"$CLAUDE_PLUGIN_DATA/venv/bin/python\" -m processrecall.integrations.claude_code close; fi'",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'if [ -e \"$CLAUDE_PLUGIN_DATA/venv/.ready\" ]; then \"$CLAUDE_PLUGIN_DATA/venv/bin/python\" -m processrecall.integrations.claude_code close; fi'",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'if [ -e \"$CLAUDE_PLUGIN_DATA/venv/.ready\" ]; then \"$CLAUDE_PLUGIN_DATA/venv/bin/python\" -m processrecall.integrations.claude_code end; fi'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
